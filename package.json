{
  "name": "iconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "server/.venv/bin/python -m uvicorn server.app.main:app --host 127.0.0.1 --port 10000 --reload",
    "start:api": "server/.venv/bin/python -m uvicorn server.app.main:app --host 127.0.0.1 --port 10000",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "server/.venv/bin/python -m server.scripts.migrate",
    "test:server": "server/.venv/bin/python -m unittest discover -s server/test -p 'test_*.py'"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.5"
  }
}
